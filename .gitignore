# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
# macOS drag-drop artifact (colon-prefixed folder name)
:.env.local/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Xcode user-specific state
*.xcuserstate
**/xcuserdata/**

# Local env (never commit)
.env
swift/Config/Secrets.xcconfig

# Swift / Xcode build products
.build/
DerivedData/
.derivedData*/
.derived-data*/
/swift/build/

# App Store 提出用の素材。スクリーンショットだけで30MBあり、履歴に入れると
# 以後の clone がずっと重くなる。正本は App Store Connect 側なので追跡しない
store-assets/
.review-dataset.json
