// Copy this file to Secrets.xcconfig and fill only local values.
// In xcconfig URLs, use :/$()/ so // is not parsed as a comment.

WANSPOT_SUPABASE_URL = https:/$()/your-project.supabase.co
WANSPOT_SUPABASE_KEY =

// Blank values use https://www.wanspot.app at runtime.
WANSPOT_API_URL =
WANSPOT_SITE_URL =

WANSPOT_AMPLITUDE_API_KEY =
WANSPOT_GOOGLE_MAPS_API_KEY =
WANSPOT_GOOGLE_WEB_CLIENT_ID =

WANSPOT_ADS_ENABLED = false
WANSPOT_ADMOB_APP_ID =
WANSPOT_ADMOB_NATIVE_AD_UNIT_ID =
WANSPOT_ADMOB_VIDEO_NATIVE_AD_UNIT_ID =
